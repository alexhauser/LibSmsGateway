<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Authors>Alexander Hauser</Authors>
    <Description>A .NET Core library for sending SMS messages via the www.sms-gateway.at HTTP2SMS API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alexhauser/LibSmsGateway</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alexhauser/LibSmsGateway</RepositoryUrl>
    <PackageTags>LibSMSGateway;SMSLib;LibSMS;SMS library;texting;text;text message;messaging;sms-gateway;sms-gateway.at; sms gateway;send sms;send text</PackageTags>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>Add authentication by API key; username/password authentication is now deprecated. Fix API errors being reported as UnknownError. Add new status codes. Allow sender IDs of up to 11 characters or 15 digits.</PackageReleaseNotes>
    <Title>LibSmsGateway</Title>
  </PropertyGroup>

</Project>
